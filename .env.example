# ============================================================================
# PayPilot Configuration Template (NVIDIA-Only)
# ============================================================================

# LLM Provider Selection (nvidia / deterministic_fallback)
LLM_PROVIDER=nvidia

# NVIDIA API Configuration (Primary & Only External LLM Provider)
# Obtain your key from: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Backend Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_URL=http://localhost:8000

# Synthetic Dataset Configuration
DATA_SEED=42
DATA_PATH=data/processed/merchant_transactions.csv
LLM_REQUEST_TIMEOUT=25.0

# API Security, Authentication & Rate Limiting
PAYPILOT_API_KEY=
PAYPILOT_ADMIN_KEY=
REQUIRE_AUTH=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Metrics & Telemetry Persistence (memory / redis)
PERSISTENCE_BACKEND=memory
REDIS_URL=

# Transaction Data Storage Configuration (csv / sqlite / postgres)
DATA_BACKEND=csv
DATABASE_URL=sqlite:///data/processed/paypilot_transactions.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

# Audit Logging Configuration
AUDIT_LOG_ENABLED=true
AUDIT_MAX_EVENTS=1000

# Background Jobs & Async Task Processing Configuration (Phase 16)
JOB_MAX_WORKERS=3
JOB_MAX_QUEUE_SIZE=50
JOB_MAX_RETAINED_JOBS=200

# Multi-Worker & Distributed Scaling Configuration (Phase 17)
APP_WORKERS=1
JOB_STORE_BACKEND=memory
RATE_LIMIT_BACKEND=memory
JOB_LEASE_TIMEOUT_SECONDS=300

# Disaster Recovery, Backup & Data Resilience (Phase 18)
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_VERIFY_ENABLED=true
AUDIT_STORE_BACKEND=memory

# Distributed Tracing & SLO Engineering (Phase 19)
TRACING_ENABLED=true
TRACE_MAX_EVENTS=5000
TRACE_MAX_TRACES=1000
SLO_ANALYZE_P95_MS=1500.0
SLO_ERROR_RATE_PERCENT=1.0
SLO_JOB_SUCCESS_PERCENT=99.0
SLO_ALERT_COOLDOWN_SECONDS=60.0

# API Traffic Management, Tenant Quotas & Idempotency (Phase 21)
ANALYZE_RATE_LIMIT_PER_MINUTE=60
JOB_RATE_LIMIT_PER_MINUTE=30
TENANT_MAX_CONCURRENT_JOBS=5
TENANT_DAILY_ANALYZE_QUOTA=1000
TENANT_DAILY_JOB_QUOTA=500
IDEMPOTENCY_STORE_BACKEND=memory
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_MAX_RECORDS=5000


